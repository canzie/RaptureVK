
@property bg-window   #181818
@property bg-canvas   #1A1A1A
@property bg-input    #111111
@property bg-panel    #252525
@property bg-header   #2F2F2F
@property bg-frame    #1F1F1F
@property bg-buttons  #383838 // not exclusive to buttons, could also be used for some context menus etc
@property bg-contrast #4D4D4D // to be used on stuff like scrollbar thumbs. should be less  

// 1=LIGHTEST, N=DARKEST

@property text-1 #EEEEEE
@property text-2 #BEBEBE
@property text-3 #868686
@property text-4 #555555

@property border-1 #1C1C1C
@property border-2 #272727
@property border-3 #343434
@property border-4 #414141

@property accent          #4772B3
@property accent-contrast #FFFFFF

// @property accent-hover    #
// @property accent-light    #
// @property accent-dark     #

@property status-error   #BF616A
@property status-warning #D08770
@property status-success #A3BE8C
@property status-info    #A3BE8C

@property type-folder #EBCB8B


@property white #FFFFFF

tab-bar {
    background-color: @bg-window;
}

text-button {
    background-color: @bg-buttons;
    text-color: @text-2;
}


// easier to use a class so that it nicely propegates these values to its children
.main-menu-bar {
    background-color: @bg-window;
    text-color: @text-1;
}

image-label {
    background-transparency: 1.0;
    image-color: @white;
}

image-button {
    background-transparency: 1.0;
    image-color: @white;
}

table {
    background-transparency: 1.0;
    border-pixel-size: 1px;
    border-color: @bg-window;
    separator-width: 1px;
    separator-color: @bg-window;
}

tree-view {
    background-transparency: 1.0;
    border-pixel-size: 0px;
    row-background-color: @bg-panel;
    row-alternate-color: @bg-frame;
}

scrolling-frame {
    scrollbar-color: @bg-header;
    scrollbar-thumb-color: @bg-contrast;
}

context-menu {
    text-color: @text-2;
    background-color: @bg-buttons;
    menu-item-hover-background: @accent;
    menu-separator-color: @border-4;
}

context-menu#separator {
    text-color: @text-3;
    background-color: @text-3;
}


.panel {
    background-color: @bg-panel;
    corner-radius: 2px;
    tab-spacing: 2px;
    tab-offset: 6px;
    tab-corner-radius: 2px 2px 0px 0px;
    tab-close-color: @text-3;

}

.panel-tab#tab {
    text-color: @text-2;
    background-transparency: 1.0;
}

.panel-tab#tab:active {
    background-color: @bg-panel;
    text-color: @text-1;
    background-transparency: 0.0;
}


.panel-tab {
    background-color: @bg-window;
}

.workspace {
    background-color: @bg-window;
    tab-spacing: 2px;
    tab-offset: 12px;
    tab-corner-radius: 2px 2px 0px 0px;
    tab-close-color: @text-3;

}

.workspace-tab#tab {
    text-color: @text-2;
    background-transparency: 1.0;
}
.workspace-tab#tab:active {
    background-color: @bg-panel;
    text-color: @text-1;
    background-transparency: 0.0;
}



.workspace-hotbar {
    background-color: @bg-panel;
}

.bottom-bar {
    background-color: @bg-panel;
}

.bottom-bar-button {
    background-transparency: 1.0;
    text-color: @text-2;
    font-size: 12px;
    text-x-alignment: center;
    text-y-alignment: center;
    
}


// stuff like the material node graph editor and spline editor, even viewport bg (if for some reason the image doesnt load)
.canvas-area {
    background-color: @bg-canvas;
    image-color: @white;
}

.property-input-field {
    font-size: 12px;
    text-color: @text-1;
    background-color: @bg-input;
    corner-radius: 2px;
    border-pixel-size: 1px;
    border-color: @border-3;
    thumb-color: @bg-contrast;
    thumb-transparency: 1.0;
    slider-fill-color: @bg-contrast;
    scrollbar-color: @bg-header;
    check-color: @accent;
    text-x-alignment: left;
    text-y-alignment: center;

}

.searchbar {
    font-size: 13px;
    text-color: @text-1;
    placeholder-color: @text-3;
    image-color: @text-3;
    background-color: @bg-input;
    corner-radius: 2px;
    border-pixel-size: 1px;
    border-color: @border-3;
    text-y-alignment: center;
}

.property-label {
    font-size: 12px;
    text-color: @text-2;
    background-color: @bg-panel;
    background-transparency: 1.0;
    text-x-alignment: left;
    text-y-alignment: center;
}

// the collapsible headers showing component information
.component-header {
    background-transparency: 1.0;
    text-color: @text-1;
    text-x-alignment: left;
    text-y-alignment: center;
}

.component-header#header {
    background-color: @bg-header;
    background-transparency: 0.0;
    text-color: @text-1;
    text-x-alignment: left;
    text-y-alignment: center;
}

.treeview-primary-column {
    text-color: @text-1;
}

.treeview-secondary-column {
    text-color: @text-2;
}

.treeview-icon {
    image-color: @text-3;
}

.treeview-icon-folder {
    image-color: @type-folder;
}

.graph-node-body {
    text-color: @text-1;
}

.viewport-context-menu {
    text-color: @text-2;
    background-color: @bg-buttons;
    
}

.viewport-context-menu#separator {
    text-color: @text-3;
    background-color: @text-3;
}

.add-asset-menu {
    text-color: @text-2;
    background-color: @bg-buttons;
}

.add-asset-menu#separator {
    text-color: @text-3;
    background-color: @text-3;
}


radio-button.viewport-context-menu {
    background-color: @bg-input;
}

radio-button.viewport-context-menu:active {
    background-color: @text-1;
}

.viewport-overlay-button {
    background-color: @bg-buttons;
    text-color: @text-2;
    corner-radius: 4px;
}

.generic-text-button {
    background-color: @bg-buttons;
    background-transparency: 0.0;
    text-color: @text-2;
    image-color: @text-2;
    border-pixel-size: 1px;
    border-color: @border-1;
    border-mode: outline;
    text-x-alignment: center;
    text-y-alignment: center;
    font-size: 12px;
    corner-radius: 2px;
}

.generic-text-button:hover {
    background-color: @bg-buttons;
    text-color: @text-1;
    border-color: @border-2;
}

.play-button {
    image-color: @status-success;
}

.play-button:active {
    image-color: @status-error;
}


.segment-control {
    background-color: @bg-input;
    text-color: @text-2;
    border-pixel-size: 1px;
    border-color: @border-1;
    border-mode: outline;
    text-x-alignment: center;
    text-y-alignment: center;
    font-size: 12px;
    corner-radius: 6px;
}

.segment-control:hover {
    text-color: @text-1;
    border-color: @border-2;
}

.segment-control:active {
    background-color: @accent;
    text-color: @text-1;
    border-color: @border-2;
}

.content-browser-section {
    background-color: @bg-panel;
}

// stuff like a grid of cards needs a nice bg
.grid-sink {
    background-color: @bg-frame;
    background-transparency: 0.0;
}

.status-bar {
    text-color: @text-3;
    background-color: @bg-header;
    text-x-alignment: left;
    text-y-alignment: center;
    font-size: 11px;
}

.content-browser-card-well {
    background-color: @bg-panel;
    corner-radius: 2px;
    border-color: @border-4;
    border-mode: outline;
    border-pixel-size: 1px;
}

.content-browser-card-well:active {
    border-color: @accent;
}

.content-browser-card-thumb {
    background-color: @bg-panel;
    background-transparency: 0.0;
}

.content-browser-card-footer {
    background-color: @bg-buttons;
    text-color: @text-1;
    text-x-alignment: center;
    text-y-alignment: center;
    text-truncate: at_end;
    font-size: 12px;
}

.content-browser-card-footer:active {
    background-color: @accent;
}

.content-browser-card-name-input {
    background-color: @bg-input;
    text-color: @text-1;
    text-x-alignment: center;
    text-y-alignment: center;
    font-size: 12px;
}

.content-browser-card-footer-type {
    background-transparency: 1.0;
    text-color: @text-2;
    text-x-alignment: center;
    text-y-alignment: center;
    text-truncate: at_end;
    font-size: 10px;
}

.launcher-backdrop {
    background-color: @bg-window;
}

.launcher-title {
    background-transparency: 1.0;
    text-color: @text-1;
    text-x-alignment: left;
    text-y-alignment: center;
    font-size: 20px;
}

.launcher-subtitle {
    background-transparency: 1.0;
    text-color: @text-3;
    text-x-alignment: left;
    text-y-alignment: center;
    font-size: 12px;
}

.launcher-section-label {
    background-transparency: 1.0;
    text-color: @text-3;
    text-x-alignment: left;
    text-y-alignment: center;
    font-size: 11px;
}

.launcher-list {
    background-color: @bg-canvas;
    border-color: @border-2;
    border-mode: outline;
    border-pixel-size: 1px;
    corner-radius: 2px;
    scrollbar-color: @bg-frame;
    scrollbar-thumb-color: @bg-contrast;
}

.launcher-list-empty {
    background-transparency: 1.0;
    text-color: @text-4;
    text-x-alignment: center;
    text-y-alignment: center;
    font-size: 12px;
}

.launcher-project {
    background-color: @bg-panel;
    border-color: @border-2;
    border-mode: outline;
    border-pixel-size: 1px;
    corner-radius: 2px;
}

.launcher-project:hover {
    background-color: @bg-buttons;
    border-color: @border-4;
}

.launcher-project-name {
    background-transparency: 1.0;
    text-color: @text-1;
    text-x-alignment: left;
    text-y-alignment: center;
    font-size: 13px;
}

.launcher-project-path {
    background-transparency: 1.0;
    text-color: @text-3;
    text-x-alignment: left;
    text-y-alignment: center;
    font-size: 11px;
}

.launcher-project-icon {
    background-transparency: 1.0;
    image-color: @text-2;
}

.launcher-name-field {
    background-color: @bg-input;
    border-color: @border-3;
    border-mode: outline;
    border-pixel-size: 1px;
    corner-radius: 2px;
    text-color: @text-1;
    placeholder-color: @text-3;
    text-y-alignment: center;
    font-size: 13px;
}

.launcher-primary-button {
    background-color: @accent;
    text-color: @accent-contrast;
    text-x-alignment: center;
    text-y-alignment: center;
    font-size: 12px;
    corner-radius: 2px;
}
