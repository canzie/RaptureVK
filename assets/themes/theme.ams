
@property bg-window   #181818
@property bg-canvas   #1A1A1A
@property bg-input    #111111
@property bg-panel    #252525
@property bg-header   #2F2F2F
@property bg-frame    #1F1F1F
@property bg-buttons  #383838 // not exclusive to buttons, could also be used for some context menus etc
@property bg-contrast #4D4D4D // to be used on stuff like scrollbar thumbs. should be less  

// 1=LIGHTEST, N=DARKEST

@property text-1 #EEEEEE
@property text-2 #BEBEBE
@property text-3 #868686
@property text-4 #555555

@property border-1 #1C1C1C
@property border-2 #272727
@property border-3 #343434
@property border-4 #414141

@property accent          #4772B3
@property accent-contrast #FFFFFF

// @property accent-hover    #
// @property accent-light    #
// @property accent-dark     #

@property status-error   #BF616A
@property status-warning #D08770
@property status-success #A3BE8C
@property status-info    #A3BE8C

@property type-folder #EBCB8B

@property selection          #3D5F99
@property checkerboard-dark  #1F1F1F
@property checkerboard-light #2A2A2A
@property hover              #333333
@property row-hover          #2B2B2B
@property input-border       #2C2C2C
@property input-border-hover #4A4A4A
@property button-hover       #424242
@property tab-hover          #222222
@property playing            #F04848
@property play-hover         #B9D3A2
@property axis-x             #C25B5B
@property axis-y             #6FA35B
@property axis-z             #4F7FC9


@property white #FFFFFF

tab-bar {
    background-color: @bg-window;
}

text-button {
    background-color: @bg-buttons;
    text-color: @text-2;
}


// easier to use a class so that it nicely propegates these values to its children
.main-menu-bar {
    background-color: @bg-window;
    text-color: @text-1;
    entry-font-size: 13px;
}

.main-menu-bar-project {
    background-color: @bg-input;
    background-transparency: 0.0;
    corner-radius: 2px;
    text-color: @text-3;
    text-x-alignment: center;
    text-y-alignment: center;
    text-truncate: ellipsis;
    font-size: 12px;
}

image-label {
    background-transparency: 1.0;
    image-color: @white;
}

image-button {
    background-transparency: 1.0;
    image-color: @white;
}

table {
    background-transparency: 1.0;
    border-pixel-size: 1px;
    border-color: @bg-window;
    separator-width: 1px;
    separator-color: @bg-window;
}

tree-view {
    background-transparency: 1.0;
    border-pixel-size: 0px;
    row-background-color: @bg-panel;
    row-alternate-color: @bg-frame;
    row-hover-color: @row-hover;
    row-selected-color: @selection;
    header-height: 24px;
    header-color: @bg-frame;
    separator-width: 2px;
    separator-color: @bg-window;
}

tree-view#header {
    font-size: 12px;
    text-color: @text-3;
    border-pixel-size: 1px;
    border-color: @bg-window;
}

scrolling-frame {
    scrollbar-color: @bg-header;
    scrollbar-thumb-color: @bg-contrast;
}

context-menu {
    text-color: @text-2;
    background-color: @bg-header;
    border-pixel-size: 1px;
    border-color: @border-4;
    corner-radius: 6px;
    font-size: 13px;
    menu-item-hover-background: @selection;
    menu-separator-color: @border-4;
}

context-menu#separator {
    text-color: @text-3;
    background-color: @text-3;
}


text-area {
    background-color: @bg-input;
    text-color: @text-1;
    font-size: 14px;
    line-height: 1.15;
    selection-color: @accent;
    cursor-color: @text-1;
}

.panel {
    background-color: @bg-panel;
    corner-radius: 4px;
    tab-spacing: 2px;
    tab-offset: 6px;
    tab-corner-radius: 4px 4px 0px 0px;
}

.panel-tab#tab {
    image-color: @text-3;
    text-color: @text-3;
    font-size: 13px;
    background-transparency: 1.0;
}

.panel-tab#tab:hover {
    image-color: @text-2;
    background-color: @bg-frame;
    text-color: @text-2;
    background-transparency: 0.0;
}

.panel-tab#tab:active {
    image-color: @text-1;
    background-color: @bg-panel;
    text-color: @text-1;
    background-transparency: 0.0;
}


.panel-tab#close,
.workspace-tab#close {
    background-color: @hover;
    background-transparency: 1.0;
    text-color: @text-4;
    corner-radius: 2px;
}

.panel-tab#close:hover,
.workspace-tab#close:hover {
    background-transparency: 0.0;
    text-color: @text-1;
}

.panel-tab {
    background-color: @bg-window;
    tab-width: 160px;
    bar-thickness: 30px;
    tab-corner-radius: 4px 4px 0px 0px;
}

.workspace {
    background-color: @bg-window;
    tab-spacing: 2px;
    tab-offset: 12px;
    tab-corner-radius: 0px;
}

.workspace-tab#tab {
    image-color: @text-3;
    background-color: @bg-frame;
    text-color: @text-3;
    font-size: 13px;
    background-transparency: 0.0;
}
.workspace-tab#tab:hover {
    image-color: @text-2;
    background-color: @tab-hover;
    text-color: @text-2;
    background-transparency: 0.0;
}
.workspace-tab#tab:active {
    image-color: @text-1;
    background-color: @bg-panel;
    text-color: @text-1;
    background-transparency: 0.0;
}



.tab-icon-tinted {
    image-transparency: 0.4;
}

.tab-icon-tinted:hover,
.tab-icon-tinted:active {
    image-transparency: 0.0;
}

.workspace-hotbar {
    background-color: @bg-panel;
}

.hotbar-separator {
    background-color: @bg-window;
}

.hotbar-item {
    background-transparency: 1.0;
}

.hotbar-button {
    background-color: @hover;
    background-transparency: 1.0;
    text-color: @text-2;
    image-color: @text-2;
    font-size: 13px;
    corner-radius: 4px;
}

.hotbar-button:hover {
    background-transparency: 0.0;
    text-color: @text-1;
    image-color: @text-1;
}

.hotbar-primary-button {
    background-color: @bg-buttons;
    text-color: @text-1;
    image-color: @status-success;
    font-family: "Roboto Bold";
    font-size: 13px;
    corner-radius: 4px;
    border-pixel-size: 1px;
    border-color: @border-4;
}

.hotbar-primary-button:hover {
    background-color: @button-hover;
    border-color: @text-4;
}

.hotbar-play-group {
    background-color: @bg-input;
    corner-radius: 6px;
    border-pixel-size: 1px;
    border-color: @input-border;
}

.hotbar-play-button {
    background-color: @hover;
    background-transparency: 1.0;
    image-color: @text-2;
    corner-radius: 4px;
}

.hotbar-play-button:hover {
    background-transparency: 0.0;
    image-color: @text-1;
}

.bottom-bar {
    background-color: @bg-panel;
}

.bottom-bar-button {
    background-color: @hover;
    background-transparency: 1.0;
    text-color: @text-2;
    font-size: 12px;
    text-x-alignment: center;
    text-y-alignment: center;
    
}

.bottom-bar-button:hover {
    background-transparency: 0.0;
    text-color: @text-1;
}

.bottom-bar-button:active {
    background-color: @bg-header;
    background-transparency: 0.0;
    text-color: @text-1;
}

.bottom-bar-separator {
    background-color: @bg-window;
}

.bottom-bar-stat-value {
    background-transparency: 1.0;
    font-family: "IBM Plex Mono";
    font-size: 11px;
    text-color: @text-2;
    text-x-alignment: right;
    text-y-alignment: center;
}

.bottom-bar-stat-unit {
    background-transparency: 1.0;
    font-family: "IBM Plex Mono";
    font-size: 11px;
    text-color: @text-3;
    text-y-alignment: center;
}

.search-field {
    background-color: @bg-input;
    corner-radius: 4px;
    border-pixel-size: 1px;
    border-color: @input-border;
}

.search-field:hover {
    border-color: @input-border-hover;
}

.search-field:focused {
    border-color: @accent;
}

.search-field-icon {
    background-transparency: 1.0;
    image-color: @text-3;
}

.search-field-input {
    background-transparency: 1.0;
    border-pixel-size: 0px;
    font-size: 13px;
    text-color: @text-1;
    placeholder-color: @text-4;
    text-y-alignment: center;
}

.command-field {
    font-family: "IBM Plex Mono";
    font-size: 12px;
    text-color: @text-1;
    placeholder-color: @text-4;
    background-color: @bg-input;
    corner-radius: 3px;
    border-pixel-size: 1px;
    border-color: @input-border;
    text-y-alignment: center;
}

.command-field:hover {
    border-color: @input-border-hover;
}

.command-popup {
    background-color: @bg-header;
    border-pixel-size: 1px;
    border-color: @border-4;
    corner-radius: 6px;
}

.command-popup-row {
    background-transparency: 1.0;
    corner-radius: 4px;
}

.command-popup-row-highlighted {
    background-color: @selection;
    corner-radius: 4px;
}

.command-popup-text {
    background-transparency: 1.0;
    text-color: @text-1;
    font-family: "IBM Plex Mono";
    font-size: 13px;
    text-x-alignment: left;
    text-y-alignment: center;
}

.command-popup-description {
    background-transparency: 1.0;
    text-color: @text-3;
    font-size: 12px;
    text-x-alignment: left;
    text-y-alignment: center;
}

.command-popup-failed {
    background-transparency: 1.0;
    text-color: @status-error;
    font-size: 12px;
    text-x-alignment: left;
    text-y-alignment: center;
}


// stuff like the material node graph editor and spline editor, even viewport bg (if for some reason the image doesnt load)
.canvas-area {
    background-color: @bg-canvas;
    image-color: @white;
}

.property-input-field {
    font-size: 12px;
    text-color: @text-1;
    background-color: @bg-input;
    corner-radius: 4px;
    border-pixel-size: 1px;
    border-color: @input-border;
    thumb-color: @bg-contrast;
    thumb-transparency: 1.0;
    slider-fill-color: @bg-buttons;
    dropdown-item-font-size: 13px;
    dropdown-popup-background: @bg-header;
    menu-item-hover-background: @selection;
    scrollbar-color: @bg-header;
    check-color: @accent;
    text-x-alignment: left;
    text-y-alignment: center;

}

.property-input-field:hover {
    border-color: @input-border-hover;
}

.property-input-field:focused {
    border-color: @accent;
}

.property-dropdown {
    padding: 0px 26px 0px 8px;
    indicator-size: 10px;
    indicator-padding: 8px;
    indicator-color: @text-3;
}

.property-dropdown:hover {
    indicator-color: @text-1;
}

.property-slider {
    padding: 1px;
    thumb-width: 0px;
}

.axis-bar-x {
    background-color: @axis-x;
    corner-radius: 3px 0px 0px 3px;
}

.axis-bar-y {
    background-color: @axis-y;
    corner-radius: 3px 0px 0px 3px;
}

.axis-bar-z {
    background-color: @axis-z;
    corner-radius: 3px 0px 0px 3px;
}

.searchbar {
    font-size: 13px;
    text-color: @text-1;
    placeholder-color: @text-4;
    image-color: @text-3;
    background-color: @bg-input;
    corner-radius: 4px;
    border-pixel-size: 1px;
    border-color: @input-border;
    text-y-alignment: center;
}

.searchbar:hover {
    border-color: @input-border-hover;
}

.property-label {
    font-size: 13px;
    text-color: @text-2;
    background-color: @bg-panel;
    background-transparency: 1.0;
    text-x-alignment: left;
    text-y-alignment: center;
}

// the collapsible headers showing component information
.component-header {
    background-transparency: 1.0;
    text-color: @text-1;
    font-family: "Roboto Bold";
    font-size: 13px;
    text-x-alignment: left;
    text-y-alignment: center;
}

.component-header#header {
    background-color: @bg-header;
    background-transparency: 0.0;
    text-color: @text-1;
    font-family: "Roboto Bold";
    font-size: 13px;
    text-x-alignment: left;
    text-y-alignment: center;
}

.treeview-primary-column {
    text-color: @text-1;
}

.treeview-secondary-column {
    text-color: @text-3;
    font-size: 12px;
}

.treeview-icon {
    image-color: @text-3;
}

.treeview-icon-folder {
    image-color: @type-folder;
}

.scene-object-root-chip {
    background-transparency: 0.65;
    corner-radius: 3px;
    font-size: 10px;
    text-color: @text-1;
    text-y-alignment: center;
}

.scene-object-component-icon {
    background-transparency: 1.0;
    image-color: @text-3;
}

// the window a scene component is picked from
.add-component-window {
    background-color: @bg-header;
    border-pixel-size: 1px;
    border-color: @border-4;
    corner-radius: 6px;
}

.add-component-title {
    background-transparency: 1.0;
    font-family: "Roboto Bold";
    font-size: 13px;
    text-color: @text-1;
    text-y-alignment: center;
}

.add-component-target {
    background-transparency: 1.0;
    font-size: 12px;
    text-color: @text-3;
    text-y-alignment: center;
}

.add-component-close {
    background-color: @bg-buttons;
    background-transparency: 1.0;
    image-color: @text-3;
    corner-radius: 4px;
}

.add-component-close:hover {
    background-transparency: 0.0;
    image-color: @text-1;
}

.add-component-divider {
    background-color: @border-4;
}

.add-component-row {
    background-color: @hover;
    background-transparency: 1.0;
    corner-radius: 4px;
}

.add-component-row:hover {
    background-transparency: 0.0;
}

.add-component-row-icon {
    background-transparency: 1.0;
    image-color: @text-2;
}

.add-component-row-name {
    background-transparency: 1.0;
    font-size: 13px;
    text-color: @text-1;
    text-y-alignment: center;
}

.add-component-row-summary {
    background-transparency: 1.0;
    font-size: 11px;
    text-color: @text-3;
    text-y-alignment: center;
}

.add-component-row-icon-attached {
    background-transparency: 1.0;
    image-color: @text-4;
}

.add-component-row-name-attached {
    background-transparency: 1.0;
    font-size: 13px;
    text-color: @text-4;
    text-y-alignment: center;
}

.add-component-row-summary-attached {
    background-transparency: 1.0;
    font-size: 11px;
    text-color: @text-4;
    text-y-alignment: center;
}

.add-component-expand {
    background-color: @bg-buttons;
    background-transparency: 1.0;
    image-color: @text-3;
    corner-radius: 4px;
}

.add-component-expand:hover {
    background-transparency: 0.0;
    image-color: @text-1;
}

.add-component-details-line {
    background-color: @border-4;
}

.add-component-details {
    background-transparency: 1.0;
    font-size: 12px;
    text-color: @text-2;
    text-x-alignment: left;
}

// the material graph: its canvas, nodes, wires and the overlays floating over it
.graph-canvas {
    background-color: @bg-canvas;
    corner-radius: 3px;
}

.graph-canvas-dots {
    background-color: @bg-header;
    corner-radius: 1px;
    background-repeat: repeat;
    background-size: 2px 2px;
    background-step: 24px;
}

.graph-node {
    background-color: @bg-panel;
    border-pixel-size: 1px;
    border-color: @border-4;
    border-mode: outline;
    corner-radius: 6px;
}

.graph-node:hover {
    border-color: @input-border-hover;
}

.graph-node:active {
    border-pixel-size: 2px;
    border-color: @accent;
}

.graph-node-header {
    corner-radius: 6px 6px 0px 0px;
}

.graph-node-icon {
    background-transparency: 1.0;
    image-color: @text-2;
}

.graph-node-title {
    background-transparency: 1.0;
    font-family: "Roboto Bold";
    font-size: 12px;
    text-color: @text-1;
    text-y-alignment: center;
}

.graph-node-pin-label {
    background-transparency: 1.0;
    font-size: 12px;
    text-color: @text-2;
    text-y-alignment: center;
}

.graph-node-axis-label {
    background-transparency: 1.0;
    font-size: 11px;
    text-color: @text-3;
    text-y-alignment: center;
}

.graph-node-field {
    font-size: 11px;
    text-x-alignment: center;
}

.graph-node-preview {
    background-color: @bg-input;
    corner-radius: 4px;
    border-pixel-size: 1px;
    border-color: @border-1;
}

.graph-pin {
    border-pixel-size: 2px;
}

.graph-wire {
    curve-thickness: 2px;
}

.graph-toolbar {
    background-color: @bg-input;
    background-transparency: 0.22;
    corner-radius: 6px;
}

.graph-toolbar-button {
    background-color: @white;
    background-transparency: 1.0;
    image-color: @text-2;
    corner-radius: 4px;
}

.graph-toolbar-button:hover {
    background-transparency: 0.9;
    image-color: @text-1;
}

.graph-crumb-icon {
    background-transparency: 1.0;
}

.graph-crumb {
    background-transparency: 1.0;
    font-size: 12px;
    text-color: @text-2;
    text-y-alignment: center;
}

.graph-crumb-current {
    background-transparency: 1.0;
    font-size: 12px;
    text-color: @text-1;
    text-y-alignment: center;
}

.graph-crumb-separator {
    background-transparency: 1.0;
    image-color: @text-4;
}

.graph-add-menu {
    background-color: @bg-header;
    border-pixel-size: 1px;
    border-color: @border-4;
    corner-radius: 6px;
}

.graph-add-results {
    background-transparency: 1.0;
    scrollbar-color: @bg-header;
    scrollbar-thumb-color: @bg-contrast;
}

.graph-add-section {
    background-transparency: 1.0;
}

.graph-add-section-title {
    background-transparency: 1.0;
    font-size: 11px;
    text-color: @text-3;
    text-y-alignment: center;
}

.graph-add-section-line {
    background-color: @border-4;
}

.graph-add-entry {
    background-color: @hover;
    background-transparency: 1.0;
    corner-radius: 4px;
}

.graph-add-entry:hover {
    background-transparency: 0.0;
}

.graph-add-entry:active {
    background-color: @selection;
    background-transparency: 0.0;
}

.graph-add-swatch {
    corner-radius: 2px;
}

.graph-add-name {
    background-transparency: 1.0;
    font-size: 13px;
    text-color: @text-1;
    text-y-alignment: center;
}

.graph-add-description {
    background-transparency: 1.0;
    font-size: 11px;
    text-color: @text-3;
    text-y-alignment: center;
}

.compile-status-note {
    background-transparency: 1.0;
    font-size: 12px;
    text-color: @text-3;
    text-x-alignment: left;
    text-y-alignment: center;
}

.compile-status-compiled {
    background-color: @status-success;
    corner-radius: 4px;
}

.compile-status-changed {
    background-color: @text-4;
    corner-radius: 4px;
}

.compile-status-failed {
    background-color: @status-error;
    corner-radius: 4px;
}

.viewport-context-menu {
    text-color: @text-2;
    background-color: @bg-header;
    border-pixel-size: 1px;
    border-color: @border-4;
    corner-radius: 6px;
    font-size: 13px;
    menu-item-hover-background: @selection;
}

.viewport-context-menu#separator {
    text-color: @text-3;
    background-color: @text-3;
}

.add-asset-menu {
    text-color: @text-2;
    background-color: @bg-header;
    border-pixel-size: 1px;
    border-color: @border-4;
    corner-radius: 6px;
    font-size: 13px;
    menu-item-hover-background: @selection;
}

.add-asset-menu#separator {
    text-color: @text-3;
    background-color: @text-3;
}


checkbox {
    background-color: @bg-input;
    background-transparency: 0.0;
    border-pixel-size: 1px;
    border-color: @border-4;
    corner-radius: 4px;
    padding: 2px;
    check-color: @accent;
}

checkbox:hover {
    border-color: @text-3;
}

.menu-checkbox {
    corner-radius: 3px;
}

radio-button {
    background-color: @bg-input;
    background-transparency: 0.0;
    border-pixel-size: 0px;
}

radio-button:active {
    background-color: @text-1;
}

.generic-text-button {
    background-color: @bg-buttons;
    background-transparency: 0.0;
    text-color: @text-2;
    image-color: @text-2;
    border-pixel-size: 1px;
    border-color: @border-1;
    text-x-alignment: center;
    text-y-alignment: center;
    font-size: 13px;
    corner-radius: 4px;
}

.generic-text-button:hover {
    background-color: @button-hover;
    text-color: @text-1;
    border-color: @border-4;
}

.accent-text-button {
    background-color: @accent;
    background-transparency: 0.0;
    text-color: @accent-contrast;
    image-color: @accent-contrast;
    border-pixel-size: 1px;
    border-color: @border-1;
    text-x-alignment: center;
    text-y-alignment: center;
    font-size: 13px;
    corner-radius: 4px;
}

.accent-text-button:hover {
    border-color: @border-4;
}

.play-button {
    image-color: @status-success;
}

.play-button:hover {
    image-color: @play-hover;
}

.play-button:active {
    image-color: @playing;
}

.playing-note {
    background-transparency: 1.0;
    text-color: @playing;
    font-size: 12px;
    text-x-alignment: left;
    text-y-alignment: center;
}

.playing-note-dot {
    background-color: @playing;
    corner-radius: 4px;
}

.viewport-image {
    corner-radius: 3px;
}

.texture-canvas {
    background-color: @bg-canvas;
    corner-radius: 3px;
}

.texture-checkerboard {
    background-color: @checkerboard-dark;
    border-pixel-size: 1px;
    border-color: @border-3;
    border-mode: outline;
}

.texture-channel-button {
    background-color: @white;
    background-transparency: 1.0;
    text-color: @text-4;
    font-size: 12px;
    corner-radius: 4px;
}

.texture-channel-button:hover {
    background-color: @row-hover;
    background-transparency: 0.0;
}

.texture-channel-button:active {
    background-color: @border-3;
    background-transparency: 0.0;
}

.texture-channel-red:active {
    text-color: @axis-x;
}

.texture-channel-green:active {
    text-color: @axis-y;
}

.texture-channel-blue:active {
    text-color: @axis-z;
}

.texture-channel-alpha:active {
    text-color: @text-1;
}

.texture-mip-thumbnail {
    background-transparency: 1.0;
    border-pixel-size: 1px;
    border-color: @border-2;
    border-mode: outline;
    corner-radius: 2px;
}

.texture-mip-thumbnail:active {
    border-pixel-size: 2px;
    border-color: @accent;
}

.texture-mip-label {
    background-transparency: 1.0;
    font-family: "IBM Plex Mono";
    font-size: 10px;
    text-color: @text-3;
    text-x-alignment: center;
    text-y-alignment: center;
}

.texture-mip-label:active {
    text-color: @text-1;
}

.texture-texel-readout {
    background-transparency: 1.0;
    font-family: "IBM Plex Mono";
    font-size: 11px;
    text-color: @text-2;
    text-y-alignment: center;
}

.texture-checkerboard-squares {
    background-color: @checkerboard-light;
    background-repeat: repeat;
    background-size: 12px 12px;
    background-step: 24px;
}

.texture-checkerboard-offset-squares {
    background-color: @checkerboard-light;
    background-repeat: repeat;
    background-size: 12px 12px;
    background-step: 24px;
    background-position: 12px 12px;
}

.orientation-gizmo {
    background-transparency: 1.0;
    border-pixel-size: 0px;
}

.viewport-toolbar {
    background-color: @bg-input;
    background-transparency: 0.22;
    corner-radius: 6px;
}

.viewport-toolbar-button {
    background-color: @white;
    background-transparency: 1.0;
    text-color: @text-1;
    image-color: @text-2;
    font-size: 12px;
    corner-radius: 4px;
}

.viewport-toolbar-button:hover {
    background-color: @row-hover;
    background-transparency: 0.0;
    image-color: @text-1;
}

.viewport-toolbar-button:active {
    background-color: @border-3;
    background-transparency: 0.0;
}

.viewport-toolbar-divider {
    background-color: @bg-header;
}

.viewport-image-playing {
    border-pixel-size: 2px;
    border-color: @playing;
    border-mode: outline;
}


.segment-control {
    background-color: @bg-input;
    text-color: @text-2;
    border-pixel-size: 1px;
    border-color: @input-border;
    text-x-alignment: center;
    text-y-alignment: center;
    font-size: 12px;
    corner-radius: 6px;
}

.segment-control:hover {
    text-color: @text-1;
    border-color: @input-border-hover;
}

.segment-control:active {
    background-color: @accent;
    text-color: @text-1;
    border-color: @border-2;
}

.content-browser-floating {
    background-color: @bg-panel;
    corner-radius: 6px;
    border-pixel-size: 1px;
    border-color: @border-4;
}

.content-browser-toolbar {
    background-color: @bg-panel;
}

.content-browser-separator {
    background-color: @bg-window;
}

.content-browser-nav-button {
    background-color: @hover;
    background-transparency: 1.0;
    image-color: @text-2;
    corner-radius: 4px;
}

.content-browser-nav-button:hover {
    background-transparency: 0.0;
    image-color: @text-1;
}

.content-browser-nav-button:disabled {
    background-transparency: 1.0;
    image-color: @text-4;
}

.content-browser-crumb {
    background-color: @hover;
    background-transparency: 1.0;
    text-color: @text-2;
    font-size: 13px;
    text-truncate: ellipsis;
    corner-radius: 4px;
    text-x-alignment: left;
    text-y-alignment: center;
}

.content-browser-crumb:hover {
    background-transparency: 0.0;
    text-color: @text-1;
}

.content-browser-crumb:active {
    text-color: @text-1;
}

.content-browser-crumb-icon {
    background-transparency: 1.0;
    image-color: @type-folder;
}

.content-browser-crumb-separator {
    background-transparency: 1.0;
    image-color: @text-4;
}

.content-browser-sidebar {
    background-color: @bg-panel;
}

.content-browser-section-chevron {
    background-transparency: 1.0;
    image-color: @text-3;
}

.content-browser-section-title {
    background-transparency: 1.0;
    font-size: 11px;
    text-color: @text-3;
    text-y-alignment: center;
}

.content-browser-section-line {
    background-color: @border-4;
}

.content-browser-folder-tree {
    row-background-color: @bg-panel;
    row-alternate-color: @bg-panel;
}

.content-browser-folder-label {
    background-transparency: 1.0;
    font-size: 13px;
    text-color: @text-2;
    text-y-alignment: center;
    text-truncate: ellipsis;
}

// stuff like a grid of cards needs a nice bg
.grid-sink {
    background-color: @bg-frame;
    background-transparency: 0.0;
}

.content-browser-status {
    background-color: @bg-panel;
    text-color: @text-3;
    font-size: 11px;
    text-x-alignment: left;
    text-y-alignment: center;
}

.content-browser-card {
    background-color: @bg-panel;
    corner-radius: 4px;
    border-pixel-size: 1px;
    border-color: @border-4;
}

.content-browser-card:hover {
    border-color: #5A5A5A;
}

.content-browser-card:active {
    border-color: @accent;
}

.content-browser-card-icon {
    background-transparency: 1.0;
    image-color: @text-2;
}

.content-browser-card-icon-folder {
    background-transparency: 1.0;
    image-color: @type-folder;
}

.content-browser-card-footer {
    background-color: @bg-buttons;
}

.content-browser-card-footer:hover {
    background-color: #404040;
}

.content-browser-card-footer:active {
    background-color: @accent;
}

.content-browser-card-name {
    background-transparency: 1.0;
    text-color: @text-1;
    font-size: 12px;
    text-x-alignment: center;
    text-y-alignment: center;
    text-truncate: ellipsis;
}

.content-browser-card-kind {
    background-transparency: 1.0;
    text-color: @text-2;
    font-size: 10px;
    text-x-alignment: center;
    text-y-alignment: center;
    text-truncate: ellipsis;
}

.content-browser-card-kind:active {
    text-color: @text-1;
}

.content-browser-card-name-input {
    background-color: @bg-input;
    text-color: @text-1;
    text-x-alignment: center;
    text-y-alignment: center;
    font-size: 12px;
}

.tooltip {
    background-color: @bg-header;
    corner-radius: 4px;
    border-pixel-size: 1px;
    border-color: @border-4;
}

.tooltip-text {
    background-transparency: 1.0;
    font-size: 12px;
    text-color: @text-2;
    text-y-alignment: center;
}

.tooltip-shortcut {
    background-transparency: 1.0;
    font-family: "IBM Plex Mono";
    font-size: 11px;
    text-color: @text-3;
    text-y-alignment: center;
}

.asset-tooltip-preview {
    background-color: @bg-panel;
    corner-radius: 4px;
    border-pixel-size: 1px;
    border-color: @border-3;
}

.asset-tooltip-dot {
    corner-radius: 2px;
}

.asset-tooltip-divider {
    background-color: @border-4;
}

.asset-tooltip-title {
    background-transparency: 1.0;
    font-family: "Roboto Bold";
    font-size: 13px;
    text-color: @text-1;
    text-y-alignment: center;
    text-truncate: ellipsis;
}

.asset-tooltip-chip {
    background-transparency: 1.0;
    font-size: 11px;
    text-color: @text-2;
    text-y-alignment: center;
}

.asset-tooltip-fact-key {
    background-transparency: 1.0;
    font-size: 12px;
    text-color: @text-3;
    text-y-alignment: center;
}

.asset-tooltip-fact-value {
    background-transparency: 1.0;
    font-size: 12px;
    text-color: @text-1;
    text-y-alignment: center;
    text-truncate: ellipsis;
}

.asset-tooltip-fact-value-mono {
    background-transparency: 1.0;
    font-family: "IBM Plex Mono";
    font-size: 11px;
    text-color: @text-2;
    text-y-alignment: center;
    text-truncate: ellipsis;
}

.file-browser-sidebar {
    background-color: @bg-panel;
    scrollbar-color: @bg-header;
    scrollbar-thumb-color: @bg-contrast;
}

.file-browser-section {
    background-transparency: 1.0;
    text-color: @text-3;
    text-x-alignment: left;
    text-y-alignment: center;
    font-size: 11px;
    indicator-color: @text-4;
}

.file-browser-section#header {
    background-transparency: 1.0;
    text-color: @text-3;
    text-x-alignment: left;
    text-y-alignment: center;
    font-size: 11px;
}

.file-browser-bookmark {
    background-color: @bg-buttons;
    background-transparency: 1.0;
    corner-radius: 3px;
}

.file-browser-bookmark:hover {
    background-transparency: 0.0;
}

.file-browser-bookmark:active {
    background-color: @accent;
    background-transparency: 0.0;
}

.file-browser-bookmark-label {
    background-transparency: 1.0;
    text-color: @text-2;
    text-x-alignment: left;
    text-y-alignment: center;
    text-truncate: ellipsis;
    font-size: 12px;
}

.file-browser-bookmark-icon {
    background-transparency: 1.0;
    image-color: @text-3;
}

.file-browser-bookmark-icon-active {
    background-transparency: 1.0;
    image-color: @type-folder;
}

.launcher-backdrop {
    background-color: @bg-window;
}

.launcher-title {
    background-transparency: 1.0;
    text-color: @text-1;
    text-x-alignment: left;
    text-y-alignment: center;
    font-size: 20px;
}

.launcher-subtitle {
    background-transparency: 1.0;
    text-color: @text-3;
    text-x-alignment: left;
    text-y-alignment: center;
    font-size: 12px;
}

.launcher-section-label {
    background-transparency: 1.0;
    text-color: @text-3;
    text-x-alignment: left;
    text-y-alignment: center;
    font-size: 11px;
}

.launcher-list {
    background-color: @bg-canvas;
    border-color: @border-2;
    border-pixel-size: 1px;
    corner-radius: 2px;
    scrollbar-color: @bg-frame;
    scrollbar-thumb-color: @bg-contrast;
}

.launcher-list-empty {
    background-transparency: 1.0;
    text-color: @text-4;
    text-x-alignment: center;
    text-y-alignment: center;
    font-size: 12px;
}

.launcher-project {
    background-color: @bg-panel;
    border-color: @border-2;
    border-pixel-size: 1px;
    corner-radius: 2px;
}

.launcher-project:hover {
    background-color: @bg-buttons;
    border-color: @border-4;
}

.launcher-project-name {
    background-transparency: 1.0;
    text-color: @text-1;
    text-x-alignment: left;
    text-y-alignment: center;
    font-size: 13px;
}

.launcher-project-path {
    background-transparency: 1.0;
    text-color: @text-3;
    text-x-alignment: left;
    text-y-alignment: center;
    font-family: "IBM Plex Mono";
    font-size: 11px;
}

.launcher-project-icon {
    background-transparency: 1.0;
    image-color: @text-2;
}

.launcher-name-field {
    background-color: @bg-input;
    border-color: @border-3;
    border-pixel-size: 1px;
    corner-radius: 2px;
    text-color: @text-1;
    placeholder-color: @text-3;
    text-y-alignment: center;
    font-size: 13px;
}

.launcher-primary-button {
    background-color: @accent;
    text-color: @accent-contrast;
    text-x-alignment: center;
    text-y-alignment: center;
    font-size: 12px;
    corner-radius: 2px;
}
