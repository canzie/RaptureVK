
@property bg-window #181818
@property bg-canvas #1A1A1A
@property bg-input  #111111
@property bg-panel  #252525
@property bg-header #2F2F2F
@property bg-frame  #1F1F1F

// 1=LIGHTEST, N=DARKEST

@property text-1 #EEEEEE
@property text-2 #BEBEBE
@property text-3 #868686
@property text-4 #555555

@property border-1 #1C1C1C
@property border-2 #272727
@property border-3 #343434
@property border-4 #414141

@property fill-1 #5A5A5A
@property fill-2 rgba(238, 238, 238, 64)

@property accent          #4772B3
@property accent-contrast #FFFFFF
// @property accent-hover    #
// @property accent-light    #
// @property accent-dark     #


@property white #FFFFFF

tab-bar {
    background-color: @bg-window;
}

menu-bar {
    background-color: @bg-window;
    text-color: @text-1;
}

image-label {
    background-transparency: 1.0;
    image-color: @white;
}

image-button {
    background-transparency: 1.0;
    image-color: @white;
}

table {
    background-transparency: 1.0;
    border-pixel-size: 1px;
    border-color: @bg-window;
    separator-width: 1px;
    separator-color: @bg-window;
}

tree-view {
    background-transparency: 1.0;
    border-pixel-size: 0px;
    row-background-color: @bg-panel;
    row-alternate-color: @bg-frame;
}

scrolling-frame {
    scrollbar-color: @bg-header;
    scrollbar-thumb-color: @fill-1;
}


.panel {
    background-color: @bg-panel;
    corner-radius: 2px;
}

.panel-tab {
    tab-color: @bg-panel;
    tab-active-color: @bg-panel;
    tab-hovered-color: @bg-panel;
    tab-pressed-color: @bg-panel;
    text-color: @text-1;
    tab-spacing: 2px;
    tab-offset: 6px;
    tab-corner-radius: 2px 2px 0px 0px;
    tab-close-color: @text-3;
}

.workspace {
    background-color: @bg-window;

}

.workspace-tab {
    tab-color: @bg-panel;
    tab-active-color: @bg-panel;
    tab-hovered-color: @bg-panel;
    tab-pressed-color: @bg-panel;
    text-color: @text-1;
    tab-spacing: 2px;
    tab-offset: 12px;
    tab-corner-radius: 2px 2px 0px 0px;
    tab-close-color: @text-3;
}

.workspace-hotbar {
    background-color: @bg-panel;
}

.bottom-bar {
    background-color: @bg-panel;
}

// stuff like the material node graph editor and spline editor, even viewport bg (if for some reason the image doesnt load)
.canvas-area {
    background-color: @bg-canvas;
    image-color: @white;
}

.property-input-field {
    font-size: 12px;
    text-color: @text-1;
    background-color: @bg-input;
    corner-radius: 2px;
    border-pixel-size: 1px;
    border-color: @border-3;
    thumb-color: @fill-1;
    thumb-transparency: 1.0;
    slider-fill-color: @fill-1;
    scrollbar-color: @bg-header;
    scrollbar-thumb-color: @fill-1;
    check-color: @accent;
    text-x-alignment: left;
    text-y-alignment: center;

}

.searchbar {
    font-size: 13px;
    text-color: @text-1;
    placeholder-color: @text-3;
    image-color: @text-3;
    background-color: @bg-input;
    corner-radius: 2px;
    border-pixel-size: 1px;
    border-color: @border-3;
}

.property-label {
    font-size: 12px;
    text-color: @text-2;
    background-color: @bg-panel;
    background-transparency: 1.0;
    text-x-alignment: left;
    text-y-alignment: center;
}

// the collapsible headers showing component information
.component-header {
    header-color: @bg-header;
    background-transparency: 1.0;
    text-color: @text-1;
    text-x-alignment: left;
    text-y-alignment: center;
}

.treeview-primary-column {
    text-color: @text-1;
}

.treeview-secondary-column {
    text-color: @text-2;
}

.graph-node-body {
    text-color: @text-1;
}
